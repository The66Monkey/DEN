# deSEC updates home., media., photos., files., and git. to your WAN IPv4.
# The installer asks for a token; chat. is also updated when Fluxer is enabled.
# downloads. is also updated when qBittorrent is enabled.
# The domain apex is not changed.
DOMAIN=home.example.net
EMAIL=you@example.net
# http requires public TCP 80; dns-desec uses the token for DNS certificates.
# dns-desec permits VPN-only remote access alongside another web server.
ACME_CHALLENGE=http
# Reserve this server address in your router. Use your actual home subnet.
LAN_IP=192.168.1.10
LAN_CIDR=192.168.1.0/24
# Larger secondary disk, mounted persistently via /etc/fstab. Bulk media/downloads only.
# Leave empty explicitly for a single-disk installation.
MEDIA_MOUNT=/mnt/den-storage
# A separate USB backup disk, mounted persistently via /etc/fstab.
BACKUP_MOUNT=/mnt/den-backup
# Explicitly accept loss of both media and its backup if sharing the HDD.
# Keep no for independent disks. This never permits backups on the OS filesystem.
ALLOW_SHARED_MEDIA_BACKUP=no
# Optional encrypted KeePassXC-compatible credential database.
KEEPASS_ENABLED=no
# Optional PUBLIC Fluxer chat and calls; all other apps stay LAN/VPN-only.
# Forward TCP 443/7881 and UDP 7882 to DEN (also TCP 80 with http certificates).
FLUXER_ENABLED=no
# Optional BitTorrent client; Web UI stays LAN/home-VPN-only.
QBITTORRENT_ENABLED=no
# Optional torrent-only outbound WireGuard with kill switch. Import a provider
# profile once using: sudo den torrent-vpn /path/to/provider.conf
# yes without a profile keeps qBittorrent stopped; no permits direct traffic.
QBITTORRENT_VPN_ENABLED=no
# Trusted source for monthly automatic releases; private repos need root Git auth.
UPDATE_REPOSITORY=https://github.com/The66Monkey/DEN.git