[Unit]
Description=DEN private VPN DNS
Requires=wg-quick@wg0.service
After=wg-quick@wg0.service network-online.target

[Service]
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/opt/den/private/dnsmasq.conf
Restart=on-failure
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target