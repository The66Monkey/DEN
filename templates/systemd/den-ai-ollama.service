[Unit]
Description=DEN private local Ollama
Wants=network-online.target
Requires=den-nvidia-power.service
After=network-online.target den-nvidia-power.service

[Service]
Type=simple
User=den-ai
Group=den-ai
EnvironmentFile=/opt/den/private/ai-ollama.env
ExecStart=/opt/den-ai/ollama-0.40.13/bin/ollama serve
Restart=on-failure
RestartSec=5
UMask=0077
MemoryMax=4G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
