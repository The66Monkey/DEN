[Unit]
Description=Update DEN deSEC DNS records with the current public IPv4
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/den/private/ddns.env
ExecStart=/bin/bash /opt/den/templates/ddns-update.sh /var/lib/den-ddns/last-ip
StateDirectory=den-ddns
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
