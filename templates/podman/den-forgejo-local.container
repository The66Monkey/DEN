[Unit]
Description=DEN local Forgejo test (HTTP, no automated backups)
ConditionPathIsMountPoint=/mnt/Storage

[Container]
Image=codeberg.org/forgejo/forgejo:17.0.1@sha256:fcd19ff4ebc85fb098a67e8e1d0d5a84d07dd6e8a23edcfdfd5b71a6178953be
ContainerName=den-forgejo-local
Network=den-local.network
PublishPort=192.168.50.109:3000:3000
Environment=USER_UID=1000 USER_GID=1000
Environment=FORGEJO__database__DB_TYPE=sqlite3 FORGEJO__server__DOMAIN=192.168.50.109
Environment=FORGEJO__server__ROOT_URL=http://192.168.50.109:3000/
Environment=FORGEJO__server__DISABLE_SSH=true FORGEJO__service__DISABLE_REGISTRATION=true
Environment=FORGEJO__security__INSTALL_LOCK=true FORGEJO__actions__ENABLED=false
Volume=/mnt/Storage/den-local/forgejo:/data:Z
HealthCmd=wget -q --spider http://localhost:3000/api/healthz
HealthInterval=30s
HealthTimeout=10s
HealthRetries=10
HealthStartPeriod=60s
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
