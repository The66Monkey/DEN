[Unit]
Description=DEN local Immich database
ConditionPathIsMountPoint=/mnt/Storage

[Container]
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
ContainerName=den-immich-db-local
Network=den-local.network
NetworkAlias=immich-db
Environment=POSTGRES_USER=immich POSTGRES_DB=immich POSTGRES_INITDB_ARGS=--data-checksums
EnvironmentFile=%h/.config/den-local/immich-db.env
Volume=/mnt/Storage/den-local/immich/database:/var/lib/postgresql/data:Z
ShmSize=128m
HealthCmd=pg_isready -U immich -d immich
HealthInterval=10s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=60s
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=900
