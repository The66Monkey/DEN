[Unit]
Description=DEN local Nextcloud background jobs
ConditionPathIsMountPoint=/mnt/Storage
Requires=den-nextcloud-local.service
After=den-nextcloud-local.service

[Container]
Image=docker.io/nextcloud:33.0.10-apache@sha256:5ded1127972ea84c29792215f0621c71929ed315cc47be946b489c7a1c1ad305
ContainerName=den-nextcloud-cron-local
Network=den-local.network
Entrypoint=/cron.sh
Volume=/mnt/Storage/den-local/nextcloud/html:/var/www/html:z
HealthCmd=kill -0 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
