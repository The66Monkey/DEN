[Unit]
Description=DEN local Nextcloud database
ConditionPathIsMountPoint=/mnt/Storage

[Container]
Image=docker.io/postgres:17@sha256:31ba9c94a03ada9988f2bb493a22a75eef3a185884533e5cdbcd498ea835b08f
ContainerName=den-nextcloud-db-local
Network=den-local.network
NetworkAlias=nextcloud-db
Environment=POSTGRES_USER=nextcloud POSTGRES_DB=nextcloud
EnvironmentFile=%h/.config/den-local/nextcloud-db.env
Volume=/mnt/Storage/den-local/nextcloud/database:/var/lib/postgresql/data:Z
HealthCmd=pg_isready -U nextcloud -d nextcloud
HealthInterval=10s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=60s
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=900
