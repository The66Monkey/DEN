[Container]
Image=docker.io/valkey/valkey:9@sha256:c123e3715db63d06d4ad6964884037aa0d5d4d703939b9929954112889708e1d
ContainerName=den-valkey-local
Network=den-local.network
NetworkAlias=valkey
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=900
